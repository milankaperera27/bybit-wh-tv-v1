# ─── ATLAS Autonomous Trading System ────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the populated .env.

# ── Runtime ────────────────────────────────────────────────────────────────
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO
BACKEND_PORT=8000
# true  -> brokers build + sign real payloads but skip the network call
# false -> live order routing
ATLAS_MOCK_BROKERS=true

# ── Infrastructure ─────────────────────────────────────────────────────────
REDIS_PORT=6379
ATLAS_REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
POSTGRES_PORT=5432
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev_password@localhost:5432/atlas

# ── Webhook authentication (spec §3 frozen contract A) ─────────────────────
# Shared secret embedded in the Pine Script "Webhook Token" input
ATLAS_WEBHOOK_TOKEN=change_me_tradingview_token
# Secret for the X-Atlas-Signature: sha256=<hex> body HMAC
ATLAS_WEBHOOK_HMAC_SECRET=change_me_hmac_secret

# ── HITL confirmation window (spec §5) ─────────────────────────────────────
ATLAS_CONFIRMATION_TTL_SECONDS=60

# ── Risk guardrails ────────────────────────────────────────────────────────
ATLAS_DEFAULT_RISK_PCT=1.0
ATLAS_MAX_RISK_PCT=5.0
ATLAS_MAX_CONTRACTS=4
ATLAS_MAX_DAILY_DRAWDOWN_PCT=3.0
ATLAS_MAX_CONCURRENT_POSITIONS=3

# ── Tradovate (CME futures — spec §4.1) ────────────────────────────────────
TRADOVATE_BASE_URL=https://demo.tradovateapi.com/v1
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Atlas
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=
TRADOVATE_ACCOUNT_SPEC=ACCOUNT_DEMO
TRADOVATE_ACCOUNT_ID=0

# ── Kraken (margin crypto — spec §4.2) ─────────────────────────────────────
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_DEFAULT_LEVERAGE=3

# ── Firebase Cloud Messaging (spec §5) ─────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=./secrets/fcm-service-account.json
FCM_DEFAULT_DEVICE_TOKEN=
