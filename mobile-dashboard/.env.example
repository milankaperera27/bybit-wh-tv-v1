# ─────────────────────────────────────────────────────────────────────────────
# ATLAS mobile dashboard — copy to `.env.local` and fill in. NEVER commit .env*.
# Every value is exposed to the browser bundle: put ONLY public client config
# here. Broker keys, the webhook HMAC secret and the FCM service account live
# exclusively in the backend `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the FastAPI middleware (FROZEN CONTRACT B, §4).
# Leave empty in dev to use the Vite proxy; set an absolute https:// origin for
# the Capacitor Android build, which cannot proxy.
VITE_API_BASE_URL=http://localhost:8000

# Firebase Cloud Messaging web app config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web Push certificate key pair (Project settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Override the WebSocket origin if the stream is not served next to the REST API.
VITE_WS_BASE_URL=
# Dev-server proxy target (vite.config.ts); defaults to http://localhost:8000
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Account equity used to render the dollar risk on a pending setup when the
# backend payload omits it.
VITE_ACCOUNT_EQUITY=100000
# Path the device push token is registered at (outside FROZEN CONTRACT B).
VITE_PUSH_REGISTER_PATH=/api/v1/push/register
