// ─────────────────────────────────────────────────────────────────────────────
// 8. alertcondition() variants — lets the same contract be wired straight from
//    the TradingView "Create Alert" dialog instead of through alert().
//    The regime is baked in per-condition so the JSON stays a const string.
//    Replace __ATLAS_WEBHOOK_TOKEN__ (and "TRADOVATE" if routing to Kraken)
//    in the alert's Message box before saving.
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(fire_buy and regime_code == 1, "ATLAS — BUY (BULL_TREND_EXPANSION)", '{"token":"__ATLAS_WEBHOOK_TOKEN__","symbol":"{{ticker}}","venue":"TRADOVATE","action":"BUY","limit_price":{{plot("limit_price")}},"stop_loss":{{plot("stop_loss")}},"take_profit_1":{{plot("take_profit_1")}},"take_profit_2":{{plot("take_profit_2")}},"regime":"BULL_TREND_EXPANSION","risk_pct":{{plot("risk_pct")}}}')
alertcondition(fire_buy and regime_code == 3, "ATLAS — BUY (RANGE_COMPRESSION)", '{"token":"__ATLAS_WEBHOOK_TOKEN__","symbol":"{{ticker}}","venue":"TRADOVATE","action":"BUY","limit_price":{{plot("limit_price")}},"stop_loss":{{plot("stop_loss")}},"take_profit_1":{{plot("take_profit_1")}},"take_profit_2":{{plot("take_profit_2")}},"regime":"RANGE_COMPRESSION","risk_pct":{{plot("risk_pct")}}}')
alertcondition(fire_sell and regime_code == 2, "ATLAS — SELL (BEAR_TREND_EXPANSION)", '{"token":"__ATLAS_WEBHOOK_TOKEN__","symbol":"{{ticker}}","venue":"TRADOVATE","action":"SELL","limit_price":{{plot("limit_price")}},"stop_loss":{{plot("stop_loss")}},"take_profit_1":{{plot("take_profit_1")}},"take_profit_2":{{plot("take_profit_2")}},"regime":"BEAR_TREND_EXPANSION","risk_pct":{{plot("risk_pct")}}}')
alertcondition(fire_sell and regime_code == 3, "ATLAS — SELL (RANGE_COMPRESSION)", '{"token":"__ATLAS_WEBHOOK_TOKEN__","symbol":"{{ticker}}","venue":"TRADOVATE","action":"SELL","limit_price":{{plot("limit_price")}},"stop_loss":{{plot("stop_loss")}},"take_profit_1":{{plot("take_profit_1")}},"take_profit_2":{{plot("take_profit_2")}},"regime":"RANGE_COMPRESSION","risk_pct":{{plot("risk_pct")}}}')
alertcondition(fire_buy, "ATLAS — Any BUY Signal", "ATLAS BUY signal on {{ticker}} {{interval}}")
alertcondition(fire_sell, "ATLAS — Any SELL Signal", "ATLAS SELL signal on {{ticker}} {{interval}}")
